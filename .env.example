# Frontend Vite env — never put Razorpay secrets here.
# Key ID is returned by the Order API for the active APP_ENV.

# URL returned as OrderApiUrl after deploying the matching backend stack:
#   modern-java-dev  -> use in .env.dev
#   modern-java-prod -> use in .env.prod
VITE_ORDER_API_URL=https://vgtwwchwuh.execute-api.ap-south-1.amazonaws.com

# Cloudflare Turnstile site key (pair with TurnstileSecretKey in backend secrets).
# Local Vite shows Cloudflare's visible test widget if this is empty.
# Amplify APP_ENV=dev still skips captcha via VITE_APP_ENV=dev.
VITE_TURNSTILE_SITE_KEY=

# Optional. Set to "dev" to disable Turnstile + payment UI in production builds
# (Amplify deploy scripts set this automatically from APP_ENV).
# VITE_APP_ENV=dev

# Localhost-only digital checkout bypass (never enable in production builds).
# Put the real secret only in gitignored .env.local / backend/sam-secrets.env.*.
VITE_DIGITAL_CHECKOUT_BYPASS=true
VITE_DIGITAL_CHECKOUT_BYPASS_SECRET=

# Analytics (loaded only after the visitor accepts the cookie banner)
# GA4 Measurement ID, e.g. G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=
# Microsoft Clarity project ID (optional; heatmaps / session replay)
VITE_CLARITY_ID=
# Meta (Facebook) Pixel ID — production builds only (e.g. 1844493498903023)
VITE_META_PIXEL_ID=

# Paperback surface (build-time Vite flags — rebuild + redeploy to change)
# Production Amplify deploy defaults to sales=false, waitlist=true.
# Paperback UI is hidden for now (mode: unavailable).
# Waitlist: VITE_PAPERBACK_SALES_ENABLED=false VITE_PAPERBACK_WAITLIST_ENABLED=true
# Restore ordering: VITE_PAPERBACK_SALES_ENABLED=true VITE_PAPERBACK_WAITLIST_ENABLED=false
VITE_PAPERBACK_SALES_ENABLED=false
VITE_PAPERBACK_WAITLIST_ENABLED=false

# Direct digital (PDF + ePub) checkout UI — API/dialogs stay intact either way.
# Production: true. Hide: false, then rebuild + redeploy.
VITE_DIGITAL_SALES_ENABLED=true

# Digital checkout campaign promo (pre-applied; must match backend CAMPAIGN_VOUCHER_CODE)
VITE_CAMPAIGN_VOUCHER_CODE=MODERNJAVA
VITE_CAMPAIGN_VOUCHER_PAYABLE_INR=699

# Copy this file to .env.dev / .env.prod (gitignored) for environment-specific deploys.
# APP_ENV for Razorpay is set by the backend stack only — not by Vite.
