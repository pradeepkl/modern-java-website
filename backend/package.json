{
  "name": "modern-java-order-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node --test",
    "test:deploy": "../scripts/test-deploy-behaviour.sh",
    "export:waitlist": "node scripts/export-paperback-waitlist.js",
    "send:review-followup": "node scripts/send-amazon-review-followup.js",
    "send:sample-followup": "node scripts/send-sample-followup.js",
    "preview:emails": "node scripts/preview-emails.js",
    "build": "sam build",
    "validate:env": "./scripts/validate-env.sh",
    "deploy": "npm run deploy:dev",
