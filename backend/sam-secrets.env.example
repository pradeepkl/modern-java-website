# Copy to sam-secrets.env and fill in real values.
# sam-secrets.env is gitignored — never commit it.

DigitalCheckoutBypassSecret=
# Cloudflare Turnstile secret (pair with VITE_TURNSTILE_SITE_KEY on the website)
TurnstileSecretKey=
