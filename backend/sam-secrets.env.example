# Copy to sam-secrets.env.dev or sam-secrets.env.prod and fill in real values.
# These files are gitignored — never commit them.
#
# Each environment file must contain ONLY the credentials for that environment.
# Do not put test and live Razorpay secrets in the same file.
# Do not put both sets into the same Lambda.

# Shared non-Razorpay secrets (optional per environment)
DigitalCheckoutBypassSecret=
TurnstileSecretKey=
ZohoClientId=
ZohoClientSecret=
ZohoRefreshToken=
ZohoOrganizationId=
ZohoTaxId=
ZohoTaxExemptionId=
# Prefer Zoho "Standard Template" (qty / rate / total), not training day-rate templates
ZohoInvoiceTemplateId=

# Razorpay — single credential set for this environment file
# sam-secrets.env.dev  → rzp_test_* keys + test webhook secret
# sam-secrets.env.prod → rzp_live_* keys + live webhook secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
